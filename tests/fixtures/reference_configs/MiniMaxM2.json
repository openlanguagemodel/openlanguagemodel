{
  "preset": "MiniMaxM2",
  "reference": "https://huggingface.co/MiniMaxAI/MiniMax-M2",
  "source": "https://huggingface.co/MiniMaxAI/MiniMax-M2/blob/757303d492a50514c312788b5247a4f696a4c6a3/config.json",
  "config": {
