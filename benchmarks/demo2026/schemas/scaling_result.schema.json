{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Throughput / weak-scaling measurement result",
  "type": "object",
  "required": [
    "framework",
    "model",
    "parameters",
    "gpu_model",
    "gpu_count",
    "interconnect",
    "precision",
    "sequence_length",
    "local_batch_size",
    "global_batch_size",
    "warmup_steps",
    "measured_steps",
    "replicate",
    "mean_step_time_ms",
    "tokens_per_second",
    "peak_memory_gb_per_gpu",
    "environment"
  ],
  "properties": {
    "framework": {"type": "string"},
    "framework_version": {"type": ["string", "null"]},
    "model": {"type": "string"},
    "parameters": {"type": "integer"},
    "gpu_model": {"type": "string"},
    "gpu_count": {"type": "integer", "minimum": 1},
    "interconnect": {"type": "string"},
    "precision": {"type": "string"},
    "sequence_length": {"type": "integer"},
    "local_batch_size": {"type": "integer"},
    "global_batch_size": {"type": "integer"},
    "grad_accum_steps": {"type": "integer"},
    "optimizer": {"type": "string"},
    "attention_backend": {"type": "string"},
    "compile": {"type": "boolean"},
    "warmup_steps": {"type": "integer"},
    "measured_steps": {"type": "integer"},
    "replicate": {"type": "integer"},
    "seed": {"type": "integer"},
    "mean_step_time_ms": {"type": "number"},
    "step_time_std_ms": {"type": "number"},
    "tokens_per_second": {"type": "number"},
    "peak_memory_gb_per_gpu": {"type": "array", "items": {"type": "number"}},
    "peak_reserved_gb_per_gpu": {"type": "array", "items": {"type": "number"}},
    "loss_first": {"type": ["number", "null"]},
    "loss_last": {"type": ["number", "null"]},
    "loss_trace": {"type": "array", "items": {"type": "number"}},
    "config": {"type": "object"},
    "config_hash": {"type": "string"},
    "command": {"type": "string"},
    "reportable": {"type": "boolean"},
    "environment": {"type": "object"}
  }
}
